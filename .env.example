# StudyOS Environment Variables Example
# Do not place real secrets in this file. Copy this file to .env and fill in the actual values.

# Django Setup
SECRET_KEY=your-super-secret-key-goes-here
DEBUG=True
ALLOWED_HOSTS=*
DJANGO_LOG_LEVEL=INFO

# Database Configuration (PostgreSQL URL for production, SQLite by default for local)
# DATABASE_URL=postgres://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# AI Integrations
GEMINI_API_KEY=your-gemini-api-key-here
